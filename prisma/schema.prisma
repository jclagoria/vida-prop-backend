// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Country {
  ES
  PT
  DE
  FR
  IT
  GB
  US
  AR
  MX
  CO
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERINTENDENT
  OWNER
  TENANT
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password         String
  documentType     String     // DNI or NIE
  documentNumber   String
  firstName        String
  lastName         String
  role             UserRole
  country          Country
  assignedBuildingIds String[]  @default([])
  isActive         Boolean    @default(true)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  buildings       Building[] @relation("UserBuildings")
  superintendentBuildings Building[] @relation("SuperintendentBuildings")
  notifications   Notification[]
  refreshTokens  RefreshToken[]

  @@index([email])
  @@map("users")
}

model Building {
  id                String   @id @default(cuid())
  name              String
  address           String
  city              String
  country           String

  userId           String?
  user             User?    @relation("UserBuildings", fields: [userId], references: [id])

  superintendentId   String?
  superintendent    User?    @relation("SuperintendentBuildings", fields: [superintendentId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([superintendentId])
  @@map("buildings")
}

model Notification {
  id       String  @id @default(cuid())
  userId   String?
  user    User?   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}