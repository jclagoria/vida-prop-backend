// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  SUPERINTENDENT
  OWNER
  TENANT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Role-specific relations
  ownedApartments Apartment[] @relation("ApartmentOwner")
  tenantProfile   Tenant?

  // System relations
  invitationsCreated Invitation[]   @relation("CreatedBy")
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([role])
  @@index([isActive])
}

model Invitation {
  id          String           @id @default(uuid())
  email       String
  role        UserRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  createdById String
  createdBy   User             @relation("CreatedBy", fields: [createdById], references: [id])
  apartment   Apartment?       @relation(fields: [apartmentId], references: [id])
  apartmentId String?
  building    Building?        @relation(fields: [buildingId], references: [id])
  buildingId  String?

  @@index([email, status])
  @@index([token])
  @@index([expiresAt])
}

model Apartment {
  id               String          @id @default(uuid())
  floorId          String
  floor            Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unitNumber       String
  uniqueIdentifier String          @unique
  totalRooms       Int
  totalArea        Decimal
  status           ApartmentStatus @default(AVAILABLE)

  ownerId    String?
  owner      User?     @relation("ApartmentOwner", fields: [ownerId], references: [id])
  building   Building? @relation(fields: [buildingId], references: [id])
  buildingId String?

  Invitation Invitation[]
  Tenant     Tenant[]

  @@index([status])
  @@index([uniqueIdentifier])
}

model Building {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  country   Country
  code      String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bodies      Body[]
  apartments  Apartment[]
  invitations Invitation[]

  @@index([country])
  @@index([city])
}

model Body {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String

  floors Floor[]

  @@unique([buildingId, name])
}

model Floor {
  id          String @id @default(uuid())
  bodyId      String
  body        Body   @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  floorNumber Int

  apartments Apartment[]

  @@unique([bodyId, floorNumber])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType
  title      String
  message    String
  readStatus Boolean          @default(false)
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  @@index([userId])
  @@index([readStatus])
  @@index([createdAt])
}

model Tenant {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id])
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id])

  @@index([userId])
  @@index([apartmentId])
}

model NoticeTemplate {
  id           String       @id @default(uuid())
  name         String       @unique
  bodyTemplate String
  type         TemplateType
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([type])
}

model CommunicationLog {
  id           String              @id @default(uuid())
  recipientId  String
  method       CommunicationMethod
  subject      String
  body         String
  sentAt       DateTime            @default(now())
  status       CommunicationStatus
  errorMessage String?

  @@index([recipientId])
  @@index([sentAt])
  @@index([status])
}

enum NotificationType {
  PAYMENT_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  MAINTENANCE_UPDATE
  MAINTENANCE_COMPLETED
  CONTRACT_EXPIRING
  GENERAL
}

enum TemplateType {
  PAYMENT_REMINDER
  MAINTENANCE_UPDATE
  GENERAL
}

enum CommunicationMethod {
  EMAIL
  IN_APP
  PAPER_NOTICE
}

enum CommunicationStatus {
  SENT
  FAILED
  PENDING
}

enum Country {
  ARGENTINA
  PARAGUAY
}

enum ApartmentStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}
