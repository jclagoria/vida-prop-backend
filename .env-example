
DATABASE_URL="url-for-your-database"

REDIS_URL=redis-url

NODE_ENV=development
PORT=3000

# Logging
LOG_PATH=./logs
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=your-JWT_EXPIRES_IN
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=your-JWT_REFRESH_EXPIRES_IN

ENCRYPTION_KEY=your-encryption-key

FRONTEND_URL=url-for-your-frontend

# Initial Admin (Phase 0 - Bootstrap)
INITIAL_ADMIN_EMAIL=admin@habitat.com
INITIAL_ADMIN_PASSWORD=SecurePass123
INITIAL_ADMIN_NAME=System Administrator
COMPANY_NAME=Habitat Properties
